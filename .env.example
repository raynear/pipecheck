# ============================================
# .env - 시크릿 전용 (프로젝트 루트)
# ============================================
# ./init이 관리 키(아래 시크릿 자리)를 재발행하고, 사용자가 직접 추가한
# 다른 키=값 줄은 전부 보존합니다 (merge-preserve).
# 이 파일의 값은 절대 앱 번들에 들어가지 않습니다 — fastlane/CLI 전용.
# 런타임 설정은 project.yaml / app_config.yaml에서 ./build가 생성합니다.
#
# ⚠️ .gitignore에 포함 — 커밋되지 않습니다.
# ============================================

# ── Android 서명 ──
KEYSTORE_PASSWORD=""
KEY_PASSWORD=""

# ── iOS Code Signing (Match) ──
MATCH_PASSWORD=""

# ── GitHub ──
GITHUB_TOKEN=""

# ── 외부 서비스 API 키 ──
TG_BOT_TOKEN=""
TG_CHAT_ID=""
DEEPL_API_KEY=""
# OPENAI_API_KEY=""

# ── 머신 자동 기록 (수동 편집 불필요, init이 보존) ──
# FIREBASE_PROJECT_ID=       (fastlane firebase 설정 시 자동 기록)
# GOOGLE_PROJECT_ID=         (fastlane gcloud 설정 시 자동 기록)
# GOOGLE_CLOUD_AUTH_TOKEN=   (fetch_google_auth_token lane에서 자동 생성)
