    {
      "name": "badge",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"badge\" (\"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"updated_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)), \"id\" INTEGER NULL PRIMARY KEY AUTOINCREMENT, \"badge_id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"description\" TEXT NOT NULL, \"icon_path\" TEXT NOT NULL, \"earned_date\" INTEGER NULL, \"is_achieved\" INTEGER NULL DEFAULT 0 CHECK (\"is_achieved\" IN (0, 1)), \"type\" INTEGER NOT NULL, \"condition\" TEXT NOT NULL);"
        }
      ]
    },
    {
