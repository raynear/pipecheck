#!/bin/bash
set -euo pipefail

# ============================================
# RaynearSoft — New App Provisioning Script
# ============================================
# 보일러플레이트 템플릿에서 새 앱 레포를 생성하고
# 전체 초기 설정을 자동화합니다.
#
# 사용법:
#   ~/Project/boiler_plate/scripts/provision \
#     --name "NewApp" \
#     --package "com.raynear.newapp" \
#     --dir ~/Project/newapp
# ============================================

# ── Colors ──
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# ── Logging helpers ──
step_start() {
  echo -e "\n${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
  echo -e "${CYAN}▶ Step $1: $2${NC}"
  echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
}

step_done() {
  echo -e "${GREEN}✓ Step $1 완료${NC}"
}

error_exit() {
  echo -e "${RED}✗ 오류: $1${NC}" >&2
  exit 1
}

warn() {
  echo -e "${YELLOW}⚠ $1${NC}"
}

info() {
  echo -e "  ${NC}$1${NC}"
}

# ── fastlane 핀 파서 ──
# project.yaml의 tooling.fastlane_ref 값을 echo. bootstrap.dart readFastlaneRef와
# 동일한 보수적 파싱(콜론 뒤 공백은 [ \t]만, 값이 비면 빈 문자열 반환).
read_fastlane_pin() {
  local yaml="$1"
  [[ -f "$yaml" ]] || return 0
  grep -E '^[[:space:]]*fastlane_ref:' "$yaml" \
    | head -1 \
    | sed -E 's/.*fastlane_ref:[[:space:]]*"?([^"#[:space:]]+).*/\1/'
}

# ── Argument parsing ──
APP_NAME=""
PACKAGE_NAME=""
TARGET_DIR=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --name)
      APP_NAME="$2"
      shift 2
      ;;
    --package)
      PACKAGE_NAME="$2"
      shift 2
      ;;
    --dir)
      TARGET_DIR="$2"
      shift 2
      ;;
    --help|-h)
      echo "Usage: provision --name <AppName> --package <com.example.app> [--dir <path>]"
      echo ""
      echo "Options:"
      echo "  --name      앱 이름 (필수, e.g., \"NewApp\")"
      echo "  --package   패키지명 (필수, e.g., \"com.raynear.newapp\")"
      echo "  --dir       프로젝트 디렉토리 (선택, 기본: ~/Project/{snake_case_name})"
      echo "  --help      이 도움말 표시"
      exit 0
      ;;
    *)
      error_exit "알 수 없는 옵션: $1 (--help 참조)"
      ;;
  esac
done

# ── Validation ──
if [[ -z "$APP_NAME" ]]; then
  error_exit "--name 은 필수입니다"
fi

if [[ -z "$PACKAGE_NAME" ]]; then
  error_exit "--package 는 필수입니다"
fi

# snake_case 변환 (PascalCase / camelCase / space → snake_case)
NAME_SNAKE=$(echo "$APP_NAME" \
  | sed 's/\([A-Z]\)/_\1/g' \
  | sed 's/^ *_//' \
  | sed 's/ /_/g' \
  | tr '[:upper:]' '[:lower:]' \
  | sed 's/__*/_/g')

# repo/dir/dart 패키지 식별자는 하나로 맞춘다: 번들 ID의 마지막 세그먼트.
# (init/rename의 defaultDartNameFor와 동일 규칙 — com.raynear.pipecheck → pipecheck.
#  APP_NAME의 snake_case는 dart 패키지명과 어긋날 수 있어 repo 이름 SSOT로 쓰지 않음:
#  --name "PipeCheck" → snake pipe_check 이지만 dart 패키지는 pipecheck.)
PACKAGE_SLUG="${PACKAGE_NAME##*.}"
REPO_NAME="$PACKAGE_SLUG"

# 기본 디렉토리 (repo·dart 패키지와 동일한 슬러그로 클론)
if [[ -z "$TARGET_DIR" ]]; then
  TARGET_DIR="$HOME/Project/$PACKAGE_SLUG"
fi

# gh CLI 확인
if ! command -v gh &>/dev/null; then
  error_exit "gh CLI가 설치되어 있지 않습니다. brew install gh 로 설치하세요."
fi

# gh 인증 확인
if ! gh auth status &>/dev/null; then
  error_exit "gh CLI 인증이 필요합니다. gh auth login 을 실행하세요."
fi

# dart 확인
if ! command -v dart &>/dev/null; then
  error_exit "dart CLI가 설치되어 있지 않습니다. Flutter SDK를 확인하세요."
fi

# 디렉토리 존재 확인
if [[ -d "$TARGET_DIR" ]]; then
  error_exit "디렉토리가 이미 존재합니다: $TARGET_DIR"
fi

# ── Summary ──
echo -e "${CYAN}"
echo "╔══════════════════════════════════════════╗"
echo "║   RaynearSoft App Provisioning           ║"
echo "╚══════════════════════════════════════════╝"
echo -e "${NC}"
info "앱 이름:      $APP_NAME"
info "패키지명:     $PACKAGE_NAME"
info "레포 이름:    raynear/$REPO_NAME"
info "디렉토리:     $TARGET_DIR"
echo ""

# ============================================
# Step 1: 레포 생성 (GitHub Template)
# ============================================
step_start 1 "GitHub 템플릿에서 레포 생성"

# gh 2.x는 `gh repo create`에 위치인자 1개(레포명)만 허용한다.
# 예전 `--clone -- "$TARGET_DIR"`는 위치인자 2개가 되어 즉사했다
# ("accepts at most 1 arg(s), received 2"). 그래서 create와 clone을 분리한다.
gh repo create "raynear/$REPO_NAME" \
  --private \
  --template raynear/boiler_plate \
  || error_exit "레포 생성 실패: raynear/$REPO_NAME (gh repo create)"

info "레포 생성 완료: raynear/$REPO_NAME"

# GitHub의 template populate는 비동기 — 방금 만든 레포는 잠시 빈 상태다.
# project.yaml(템플릿 루트 파일)이 contents API에 나타날 때까지 폴링한 뒤 clone.
# (빈 레포를 clone하면 브랜치·파일이 없어 이후 Step들이 전부 실패한다.)
info "템플릿 populate 대기 중 (project.yaml 등장까지)..."
POPULATE_OK=0
for _attempt in $(seq 1 30); do
  if gh api "repos/raynear/$REPO_NAME/contents/project.yaml" &>/dev/null; then
    POPULATE_OK=1
    break
  fi
  sleep 2
done
if [[ "$POPULATE_OK" -ne 1 ]]; then
  error_exit "템플릿 populate가 60초 내 완료되지 않았습니다. 잠시 후 수동 clone: gh repo clone raynear/$REPO_NAME \"$TARGET_DIR\""
fi

gh repo clone "raynear/$REPO_NAME" "$TARGET_DIR" \
  || error_exit "clone 실패: raynear/$REPO_NAME -> $TARGET_DIR"

info "클론 위치: $TARGET_DIR"
step_done 1

# ============================================
# Step 2: 앱 이름/번들ID/패키지명 치환
# ============================================
step_start 2 "앱 이름 및 패키지명 치환"

# project.yaml 직접 업데이트
PROJECT_YAML="$TARGET_DIR/project.yaml"
if [[ -f "$PROJECT_YAML" ]]; then
  sed -i '' "s|name: \".*\"|name: \"$APP_NAME\"|" "$PROJECT_YAML"
  sed -i '' "s|package_name: \".*\"|package_name: \"$PACKAGE_NAME\"|" "$PROJECT_YAML"
  sed -i '' "s|github_repository: \".*\"|github_repository: \"raynear/$REPO_NAME\"|" "$PROJECT_YAML"
  info "project.yaml 업데이트 완료"
else
  warn "project.yaml을 찾을 수 없습니다"
fi

# init.dart로 내부 치환 수행
info "init.dart 실행 중..."
(cd "$TARGET_DIR" && dart run tools/cli/bin/init.dart --name "$APP_NAME" --package "$PACKAGE_NAME") || {
  warn "init.dart 실행 실패 — 수동으로 실행 필요: cd $TARGET_DIR && dart run tools/cli/bin/init.dart --name \"$APP_NAME\" --package \"$PACKAGE_NAME\""
}

step_done 2

# ============================================
# Step 3: CI/CD 워크플로우 치환
# ============================================
step_start 3 "CI/CD 워크플로우 확인"

WORKFLOWS_DIR="$TARGET_DIR/.github/workflows"
if [[ -d "$WORKFLOWS_DIR" ]]; then
  # 워크플로우 내 boiler_plate / boilerplate 참조를 앱명으로 치환
  for wf in "$WORKFLOWS_DIR"/*.yml; do
    if [[ -f "$wf" ]]; then
      sed -i '' "s/boiler_plate/$NAME_SNAKE/g" "$wf"
      sed -i '' "s/boilerplate/$NAME_SNAKE/g" "$wf"
      info "$(basename "$wf") 치환 완료"
    fi
  done
else
  warn ".github/workflows 디렉토리 없음 — 스킵"
fi

step_done 3

# ============================================
# Step 4: fastlane 별도 repo로 교체 + bundle install
# ============================================
# 템플릿에서 복사된 fastlane/ 을 삭제하고,
# 별도 repo(flutter-fastlane)를 clone해서 배치한다.
# 환경 변수 FASTLANE_REPO 로 URL 재정의 가능.
# ============================================
step_start 4 "fastlane repo 교체 + bundle install"

FASTLANE_REPO="${FASTLANE_REPO:-https://github.com/raynear/flutter-fastlane.git}"
# project.yaml tooling.fastlane_ref 핀을 따른다 (하드코딩 main 금지).
FASTLANE_PIN="${FASTLANE_PIN:-$(read_fastlane_pin "$PROJECT_YAML")}"
if [[ -z "$FASTLANE_PIN" ]]; then
  warn "project.yaml에서 fastlane_ref 핀을 찾지 못했습니다 — main으로 폴백합니다."
  FASTLANE_PIN="main"
fi
FASTLANE_DIR="$TARGET_DIR/fastlane"

# fastlane 확보: 우선 git submodule, 없으면 핀 태그로 clone.
# (이 템플릿은 fastlane을 submodule로 둔다. 복사 기반 파생 앱은 clone 폴백.)
if [[ -f "$TARGET_DIR/.gitmodules" ]] && grep -q 'path = fastlane' "$TARGET_DIR/.gitmodules" 2>/dev/null; then
  info "fastlane submodule 초기화 ($FASTLANE_PIN)"
  (cd "$TARGET_DIR" && git submodule update --init --recursive fastlane) \
    || warn "fastlane submodule 초기화 실패 — 수동 확인 필요"
else
  # 복사 기반 파생 앱: 템플릿 복사본 삭제 후 핀 태그로 clone.
  if [[ -d "$FASTLANE_DIR" ]] && [[ ! -d "$FASTLANE_DIR/.git" ]]; then
    info "템플릿에서 복사된 fastlane/ 삭제 중..."
    rm -rf "$FASTLANE_DIR"
    (cd "$TARGET_DIR" && git rm -rf fastlane 2>/dev/null) || true
  fi
  if [[ -d "$FASTLANE_DIR/.git" ]]; then
    info "이미 fastlane repo가 clone되어 있습니다. 핀($FASTLANE_PIN)으로 갱신합니다."
    (git -C "$FASTLANE_DIR" fetch --tags --depth 1 origin "$FASTLANE_PIN" \
      && git -C "$FASTLANE_DIR" checkout --detach "$FASTLANE_PIN") \
      || warn "fastlane 핀 갱신 실패 — 수동 확인 필요"
  else
    info "clone: $FASTLANE_REPO ($FASTLANE_PIN) -> $FASTLANE_DIR"
    git clone --branch "$FASTLANE_PIN" --depth 1 "$FASTLANE_REPO" "$FASTLANE_DIR" || {
      warn "fastlane repo clone 실패 — 수동으로 clone 하세요: git clone --branch $FASTLANE_PIN $FASTLANE_REPO $FASTLANE_DIR"
    }
  fi
fi

# bundle install (fastlane/Gemfile 기준)
if command -v bundle &>/dev/null; then
  if [[ -f "$FASTLANE_DIR/Gemfile" ]]; then
    info "bundle install 실행 중..."
    (cd "$FASTLANE_DIR" && bundle install) || {
      warn "bundle install 실패 — 수동으로 실행 필요: cd $FASTLANE_DIR && bundle install"
    }
  else
    warn "fastlane/Gemfile을 찾을 수 없습니다. clone 이 완료되었는지 확인하세요."
  fi
else
  warn "bundler가 설치되어 있지 않습니다. gem install bundler 후 bundle install을 실행하세요."
fi

step_done 4

# ============================================
# Step 5: lifecycle.json 생성
# ============================================
step_start 5 "lifecycle.json 생성"

CREATED_AT=$(date -u +"%Y-%m-%dT%H:%M:%SZ")

cat > "$TARGET_DIR/lifecycle.json" << LIFECYCLE_EOF
{
  "app_name": "$APP_NAME",
  "package_name": "$PACKAGE_NAME",
  "created_at": "$CREATED_AT",
  "phase": "Phase 1",
  "status": "development",
  "store": {
    "ios": "not_submitted",
    "android": "not_submitted"
  }
}
LIFECYCLE_EOF

info "lifecycle.json 생성 완료"
step_done 5

# ============================================
# Step 6: COMPANY.md 업데이트 안내
# ============================================
step_start 6 "COMPANY.md 업데이트 안내"

echo -e "${YELLOW}아래 내용을 ~/CoWork/raynearsoft/memory/COMPANY.md 앱 현황 테이블에 추가하세요:${NC}"
echo ""
echo "  | $APP_NAME | $PACKAGE_NAME | Phase 1 | development | $TARGET_DIR |"
echo ""

step_done 6

# ============================================
# Step 7: 랜딩 페이지 scaffold 안내
# ============================================
step_start 7 "랜딩 페이지 scaffold 안내"

echo -e "${YELLOW}raynearsoft-web 프로젝트에 앱 페이지를 추가하세요:${NC}"
echo ""
echo "  1. ~/Project/raynearsoft-web/src/pages/${NAME_SNAKE}/ 디렉토리 생성"
echo "  2. 기존 앱 페이지를 참고하여 랜딩 페이지 템플릿 작성"
echo "  3. 프라이버시 정책 / 이용약관 페이지 추가"
echo "  4. 내비게이션에 앱 링크 추가"
echo ""

step_done 7

# ============================================
# Step 8: 첫 커밋 + push
# ============================================
step_start 8 "첫 커밋 및 push"

(
  cd "$TARGET_DIR"
  git add -A
  # 변경사항이 있을 때만 커밋
  if ! git diff --cached --quiet; then
    git commit -m "init: $APP_NAME 프로젝트 초기화 (boilerplate 기반)"
    git push -u origin main
    info "커밋 및 push 완료"
  else
    info "변경사항 없음 — 커밋 스킵"
    # remote tracking 설정만
    git push -u origin main 2>/dev/null || true
  fi
)

step_done 8

# ============================================
# Step 9: 수동 작업 안내
# ============================================
step_start 9 "수동 작업 안내"

echo -e "${YELLOW}아래 항목을 수동으로 설정하세요:${NC}"
echo ""
echo -e "${CYAN}[Discord 채널 설정]${NC}"
echo "  1. RaynearSoft Discord 서버에 #${NAME_SNAKE} 채널 생성 (APPS 카테고리)"
echo "  2. 봇 권한 설정 (메시지 읽기/쓰기)"
echo "  3. discord-protocol.md 채널 매핑 업데이트"
echo ""
echo -e "${CYAN}[.env 파일 설정]${NC}"
echo "  cd $TARGET_DIR"
echo "  cp .env.example .env"
echo "  # 아래 항목을 채우세요:"
echo "    - KEYSTORE_PASSWORD, KEY_PASSWORD (Android 서명)"
echo "    - MATCH_PASSWORD (iOS Code Signing)"
echo "    - GITHUB_TOKEN"
echo "    - 외부 서비스 API 키 (필요 시)"
echo ""
echo -e "${CYAN}[GitHub Secrets 설정]${NC}"
echo "  gh secret set KEYSTORE_PASSWORD -R raynear/$REPO_NAME"
echo "  gh secret set KEY_PASSWORD -R raynear/$REPO_NAME"
echo "  gh secret set MATCH_PASSWORD -R raynear/$REPO_NAME"
echo "  gh secret set FIREBASE_APP_ID_IOS -R raynear/$REPO_NAME"
echo "  gh secret set FIREBASE_APP_ID_ANDROID -R raynear/$REPO_NAME"
echo ""
echo -e "${CYAN}[Firebase 프로젝트 생성]${NC}"
echo "  1. Firebase Console에서 새 프로젝트 생성"
echo "  2. iOS / Android 앱 등록"
echo "  3. GoogleService-Info.plist → $TARGET_DIR/ios/Runner/"
echo "  4. google-services.json → $TARGET_DIR/android/app/"
echo "  5. Firebase App Distribution 설정 (CI/CD용)"
echo ""

step_done 9

# ── 완료 ──
echo ""
echo -e "${GREEN}╔══════════════════════════════════════════╗${NC}"
echo -e "${GREEN}║   프로비저닝 완료!                        ║${NC}"
echo -e "${GREEN}╚══════════════════════════════════════════╝${NC}"
echo ""
echo -e "  프로젝트: ${CYAN}$TARGET_DIR${NC}"
echo -e "  레포:     ${CYAN}https://github.com/raynear/$REPO_NAME${NC}"
echo ""
